rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Comptes autorisés ; chacun accède uniquement au chemin de son UID.
  // Remplacer REMPLACER_UID_FRERE et REMPLACER_UID_COMPAGNE (une seule fois chacun, juste ci-dessous) par les UID Firebase des deux nouveaux comptes.
  // Tant qu'ils ne sont pas remplacés, ces deux entrées ne correspondent à aucun compte réel.
  function frere() { return 'REMPLACER_UID_FRERE'; }
  function compagne() { return 'REMPLACER_UID_COMPAGNE'; }
  function owner(uid) {
   return request.auth != null && request.auth.uid == uid
    && request.auth.uid in ['Ip5pI839d4WwxI818ujNyH4a2xl1', 'zv1huPM37lVmr9tbpsCCzl5Bfj72', frere(), compagne()];
  }
  function short(s,n) { return s is string && s.size() <= n; }
  function dateText(s) { return short(s,10) && (s == '' || s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
  function textList(v,n,max) {
   return v is list && v.size() <= max
    && (v.size() <= 0 || short(v[0],n))
    && (v.size() <= 1 || short(v[1],n))
    && (v.size() <= 2 || short(v[2],n))
    && (v.size() <= 3 || short(v[3],n))
    && (v.size() <= 4 || short(v[4],n))
    && (v.size() <= 5 || short(v[5],n))
    && (v.size() <= 6 || short(v[6],n))
    && (v.size() <= 7 || short(v[7],n))
    && (v.size() <= 8 || short(v[8],n))
    && (v.size() <= 9 || short(v[9],n))
    && (v.size() <= 10 || short(v[10],n))
    && (v.size() <= 11 || short(v[11],n))
   ;
  }
  function valid(d,id) {
   return d.keys().hasAll(['id','title','authors','genres','description','publisher','published','pages','isbn','cover','status','owned','wish','series','volume','rating','notes','started','finished','source','createdAt','updatedAt'])
    && d.keys().hasOnly(['id','title','authors','genres','description','publisher','published','pages','isbn','cover','status','owned','wish','series','volume','rating','notes','started','finished','source','createdAt','updatedAt'])
    && short(d.id,100) && d.id == id && d.id.matches('^[a-zA-Z0-9_-]+$')
    && short(d.title,250) && d.title.size() > 0
    && textList(d.authors,120,10)
    && textList(d.genres,60,12)
    && short(d.description,12000) && short(d.notes,10000)
    && short(d.publisher,200) && short(d.published,40)
    && d.pages is int && d.pages >= 0 && d.pages <= 50000
    && short(d.isbn,13) && (d.isbn == '' || d.isbn.matches('^([0-9]{13}|[0-9]{9}[0-9X])$'))
    && short(d.cover,2000) && (d.cover == '' || d.cover.matches('^https://(books[.]google[.]com|books[.]google[.]fr|books[.]googleusercontent[.]com|covers[.]openlibrary[.]org|iadice[.]com|is[1-5]-ssl[.]mzstatic[.]com)/.*$'))
    && d.status in ['unread','reading','read'] && d.owned is bool && d.wish is bool
    && short(d.series,200) && d.volume is int && d.volume >= 0 && d.volume <= 10000
    && d.rating is int && d.rating >= 0 && d.rating <= 5
    && dateText(d.started) && dateText(d.finished)
    && (d.started == '' || d.finished == '' || d.started <= d.finished)
    && d.source in ['Google Books','Open Library','Manuel']
    && short(d.createdAt,40) && short(d.updatedAt,40)
    && d.createdAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*$')
    && d.updatedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*$');
  }
  match /users/{uid}/books/{id} {
   allow read, delete: if owner(uid);
   allow create: if owner(uid) && valid(request.resource.data,id);
   allow update: if owner(uid) && valid(request.resource.data,id)
    && request.resource.data.createdAt == resource.data.createdAt;
  }
  // Films et séries : réservés aux comptes habilités (pas la lectrice, ni un tiers, ni l’anonyme).
  function mediaOwner(uid) {
   return owner(uid) && request.auth.uid in ['zv1huPM37lVmr9tbpsCCzl5Bfj72', frere(), compagne()];
  }
  function validMedia(d,id) {
   return d.keys().hasAll(['id','kind','title','creators','genres','year','description','poster','status','season','episode','rating','notes','started','finished','source','imageCredit','imageSourceUrl','imageLicenseUrl','catalogId','sourceUrl','createdAt','updatedAt'])
    && d.keys().hasOnly(['id','kind','title','creators','genres','year','description','poster','status','season','episode','rating','notes','started','finished','source','imageCredit','imageSourceUrl','imageLicenseUrl','catalogId','sourceUrl','createdAt','updatedAt'])
    && short(d.id,100) && d.id == id && d.id.matches('^[a-zA-Z0-9_-]+$')
    && d.kind in ['movie','series'] && short(d.title,250) && d.title.size() > 0
    && textList(d.creators,120,10) && textList(d.genres,60,12)
    && short(d.year,4) && (d.year == '' || d.year.matches('^[0-9]{1,4}$'))
    && short(d.description,12000) && short(d.notes,10000)
    && short(d.poster,2000) && (d.poster == '' || d.poster.matches('^https://(is[1-5]-ssl[.]mzstatic[.]com|static[.]tvmaze[.]com|upload[.]wikimedia[.]org|thumb[.]wikimedia[.]org|image[.]tmdb[.]org)/.*$'))
    && d.status in ['unwatched','watching','watched']
    && d.season is int && d.season >= 0 && d.season <= 10000
    && d.episode is int && d.episode >= 0 && d.episode <= 100000
    && (d.kind == 'series' || (d.season == 0 && d.episode == 0 && d.status != 'watching'))
    && d.rating is int && d.rating >= 0 && d.rating <= 5
    && dateText(d.started) && dateText(d.finished) && (d.started == '' || d.finished == '' || d.started <= d.finished)
    && d.source in ['Apple Movies','TVmaze','Wikipédia','TMDB','Manuel'] && short(d.catalogId,100)
    && short(d.imageCredit,500) && short(d.imageSourceUrl,2000) && short(d.imageLicenseUrl,2000)
    && (d.imageSourceUrl == '' || d.imageSourceUrl.matches('^https://(commons[.]wikimedia[.]org|fr[.]wikipedia[.]org|en[.]wikipedia[.]org|www[.]tvmaze[.]com|itunes[.]apple[.]com|tv[.]apple[.]com)/.*$'))
    && (d.imageLicenseUrl == '' || d.imageLicenseUrl.matches('^https://creativecommons[.]org/.*$'))
    && (!d.poster.matches('^https://(upload|thumb)[.]wikimedia[.]org/.*$') || (d.imageCredit.size() > 0 && d.imageSourceUrl.size() > 0 && d.imageLicenseUrl.size() > 0))
    && short(d.sourceUrl,2000) && (d.sourceUrl == ''
     || (d.source == 'TVmaze' && d.sourceUrl.matches('^https://www[.]tvmaze[.]com/.*$'))
     || (d.source == 'Wikipédia' && d.sourceUrl.matches('^https://(fr|en)[.]wikipedia[.]org/.*$'))
     || (d.source == 'TMDB' && d.sourceUrl.matches('^https://www[.]themoviedb[.]org/.*$'))
     || (d.source == 'Apple Movies' && d.sourceUrl.matches('^https://(itunes[.]apple[.]com|tv[.]apple[.]com)/.*$')))
    && short(d.createdAt,40) && short(d.updatedAt,40)
    && d.createdAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*$')
    && d.updatedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*$');
  }
  match /users/{uid}/media/{id} {
   allow read, delete: if mediaOwner(uid);
   allow create: if mediaOwner(uid) && validMedia(request.resource.data,id);
   allow update: if mediaOwner(uid) && validMedia(request.resource.data,id)
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.kind == resource.data.kind;
  }
  // Préférences de recommandations et de notifications : un seul document par compte.
  function genreList(v,allowed) { return v is list && v.size() <= 20 && v.hasOnly(allowed); }
  function validPrefs(d) {
   return d.keys().hasAll(['genresBook','genresMovie','genresSeries','useLibrary','notifyMovies','notifySeries','notifyFollowed','updatedAt'])
    && d.keys().hasOnly(['genresBook','genresMovie','genresSeries','useLibrary','notifyMovies','notifySeries','notifyFollowed','updatedAt'])
    && genreList(d.genresBook,['Roman','Policier / Thriller','Romance','New Romance','Fantasy','Science-fiction','Historique','Contemporain','Littérature générale','Biographie','Essai','BD / Manga','Jeunesse'])
    && genreList(d.genresMovie,['Action','Aventure','Animation','Comédie','Crime','Documentaire','Drame','Familial','Fantastique','Histoire','Horreur','Musique','Mystère','Romance','Science-fiction','Thriller','Guerre','Western'])
    && genreList(d.genresSeries,['Action & aventure','Animation','Comédie','Crime','Documentaire','Drame','Familial','Mystère','Science-fiction & fantastique','Guerre & politique','Western'])
    && d.useLibrary is bool && d.notifyMovies is bool && d.notifySeries is bool && d.notifyFollowed is bool
    && short(d.updatedAt,40) && d.updatedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*$');
  }
  match /users/{uid}/prefs/{id} {
   allow read, delete: if owner(uid) && id == 'main';
   allow create, update: if owner(uid) && id == 'main' && validPrefs(request.resource.data);
  }
  match /{document=**} { allow read, write: if false; }
 }
}
